server {
    listen 80;
    listen [::]:80;

    server_name *.flo1.de flo1.de;

    return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;

  server_name mara.flo1.de;
  ssl_certificate /etc/nginx/certs/flo1.de.pem;
  ssl_certificate_key /etc/nginx/certs/flo1.de.key;

  ssl_verify_client on;
  ssl_client_certificate /etc/nginx/certs/cloudflare.crt;

  location / {
        proxy_pass http://host.docker.internal:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;

  server_name monitoring.flo1.de;
  ssl_certificate /etc/nginx/certs/flo1.de.pem;
  ssl_certificate_key /etc/nginx/certs/flo1.de.key;

  ssl_verify_client on;
  ssl_client_certificate /etc/nginx/certs/cloudflare.crt;

  location / {
        proxy_pass http://host.docker.internal:3003;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}