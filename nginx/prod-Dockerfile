FROM node:lts-alpine

WORKDIR /app
COPY ../frontend/package*.json ./
RUN npm ci
COPY ../frontend/ .
RUN npm run build

FROM nginx:1.21.6
COPY --from=0 /app/dist /app/dist
RUN rm /etc/nginx/conf.d/default.conf
COPY ./nginx/prod.conf /etc/nginx/conf.d/default.conf
COPY ./nginx/certs/floslabs.de.key /etc/nginx/certs/floslabs.de.key
COPY ./nginx/certs/floslabs.de.pem /etc/nginx/certs/floslabs.de.pem
COPY ./nginx/certs/cloudflare.crt /etc/nginx/certs/cloudflare.crt

COPY ./nginx/flo1.config /etc/nginx/conf.d/flo1.de.conf
COPY ./nginx/certs/flo1.de.key /etc/nginx/certs/flo1.de.key
COPY ./nginx/certs/flo1.de.pem /etc/nginx/certs/flo1.de.pem

EXPOSE 80
EXPOSE 443
